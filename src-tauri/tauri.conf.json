{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARCHVISTA",
  "version": "1.5.2",
  "identifier": "app.archvista.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARCHVISTA",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force_high_performance_gpu --ignore-gpu-blocklist"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: http://preview.localhost preview:; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:; frame-src http://preview.localhost preview:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Judith Steinacher",
    "category": "Graphics and Design",
    "shortDescription": "3D-DXF zu interaktiver Architektur-Website",
    "longDescription": "ARCHVISTA verwandelt 3D-DXF-Dateien aus AutoCAD in fotorealistische, begehbare Websites und veröffentlicht sie über GitHub Pages.",
    "copyright": "© 2026 Judith Steinacher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "dxf"
        ],
        "name": "DXF",
        "description": "AutoCAD DXF",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": [
          "de-DE",
          "en-US"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1RjJBRDMzNjREMTM5MjYKUldRbU9kRmtNNjN5QmNDMFRteHM1U3VlYWIzMno0Q0RpOXFBdkh0cHpIU1E0dDhrSWxwR0piT3gK",
      "endpoints": [
        "https://github.com/steinacher-designs/archvista/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
